# Configuración de entornos
#
# El backend carga `.env` y luego el archivo del entorno activo.
# El archivo del entorno (`.env.local`, `.env.qa`, `.env.production`) tiene prioridad.
#
# NODE_ENV=local      -> .env.local
# NODE_ENV=qa         -> .env.qa
# NODE_ENV=production -> .env.production
#
# Puedes seguir usando solo `.env` en desarrollo; `.env.local` es opcional.
NODE_ENV=local
PORT=3000

# Orígenes permitidos para CORS (separados por coma, sin barra final)
# CORS_ORIGINS=http://localhost:5173,https://jarvis-frontend-lovat.vercel.app

# Base de datos (Neon / PostgreSQL)
DATABASE_URL=
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Autenticación JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SIIGO (fallback cuando no están en integrations.credentials)
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DEFAULT_TAX_RATE=

# Redis (opcional; sin REDIS_URL usa memoria)
REDIS_URL=
IMPORT_SESSION_TTL_SECONDS=3600
