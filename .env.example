# Configuración de entornos
#
# El backend carga `.env` y luego el archivo del entorno activo.
# El archivo del entorno (`.env.local`, `.env.qa`, `.env.production`) tiene prioridad.
#
# NODE_ENV=local      -> .env.local
# NODE_ENV=qa         -> .env.qa
# NODE_ENV=production -> .env.production
#
# Puedes seguir usando solo `.env` en desarrollo; `.env.local` es opcional.
NODE_ENV=local
PORT=3000

# Orígenes permitidos para CORS (separados por coma, sin barra final)
# CORS_ORIGINS=http://localhost:5173,https://jarvis-frontend-lovat.vercel.app

# Base de datos (Neon / PostgreSQL)
DATABASE_URL=
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Autenticación JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SIIGO (fallback cuando no están en integrations.credentials)
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DEFAULT_TAX_RATE=

# NextPyme (consulta de datos RUT/RUES por NIT)
# Usado como fallback para autocompletar terceros cuando la empresa
# no tiene token_nextpyme en la integración Jarvis/NextPyme.
NEXTPYME_BASE_URL=https://api.nextpyme.plus/api/ubl2.1
NEXTPYME_API_TOKEN=
# Consulta de factura recibida por CUFE (para autocompletar facturas de compra)
NEXTPYME_INVOICE_QUERY_URL=https://api.nextpyme.plus/api/return-invoice-data

# Redis (opcional; sin REDIS_URL usa memoria)
REDIS_URL=
IMPORT_SESSION_TTL_SECONDS=3600

# OpenRouter (sugerencias de IA: tipo de ítem + cuenta contable en facturas
# de compra, cuando no hay una regla confirmada con suficiente confianza).
# Formato OpenAI-compatible (chat/completions) enrutado a través de OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Importación masiva de Factura de compra (worker en PostgreSQL, ver src/worker.ts)
PURCHASE_INVOICE_IMPORT_BATCH_SIZE=20
PURCHASE_INVOICE_IMPORT_CONCURRENCY=4
PURCHASE_INVOICE_IMPORT_MAX_RETRIES=2
PURCHASE_INVOICE_PROCESSING_TIMEOUT_MINUTES=10
PURCHASE_INVOICE_WORKER_POLL_INTERVAL_MS=2000
